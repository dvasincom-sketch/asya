// Ася — схема БД. Полная модель под весь продукт; на шаге 2 (чат) ещё не используется,
// но лежит готовой для шагов 3+ (вход, память, история, подписка).
generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки, debian-openssl-3.0.x — для Docker-образа (node:20-bookworm)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  tgId             BigInt?  @unique
  phone            String?  @unique
  createdAt        DateTime @default(now())
  consentAt        DateTime?
  consentVersion   String?
  memoryEnabled    Boolean  @default(true)
  historyEnabled   Boolean  @default(true)
  remindersEnabled Boolean  @default(true)

  messages     Message[]
  memories     Memory[]
  consents     Consent[]
  subscription Subscription?
  crisisEvents CrisisEvent[]
  sessions     Session[]
  coachSessions CoachSession[]
}

// Структурированная сессия («разбор»): шаблон задаёт невидимый каркас вопросов,
// а разговор и итог — настоящие, из ответов человека.
model CoachSession {
  id        String    @id @default(cuid())
  userId    String
  template  String
  step      Int       @default(0)
  done      Boolean   @default(false)
  summary   String?
  savedAt   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns     SessionTurn[]

  @@index([userId, createdAt])
}

model SessionTurn {
  id        String       @id @default(cuid())
  sessionId String
  phase     Int
  role      String
  content   String
  createdAt DateTime     @default(now())
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  fact      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  version   String
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String    @unique
  status       String
  provider     String    @default("yookassa")
  externalId   String?
  nextChargeAt DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrisisEvent {
  id        String   @id @default(cuid())
  userId    String
  level     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Серверный дневной счётчик сообщений. key = "u:<userId>:<yyyy-mm-dd>" для вошедших,
// "ip:<ip>:<yyyy-mm-dd>" для анонимов. Защита от злоупотреблений и мягкий лимит.
model DailyUsage {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
}
