// Ася — схема БД. Полная модель под весь продукт; на шаге 2 (чат) ещё не используется,
// но лежит готовой для шагов 3+ (вход, память, история, подписка).
generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки, debian-openssl-3.0.x — для Docker-образа (node:20-bookworm)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  tgId             BigInt?  @unique
  phone            String?  @unique
  // Профиль из Telegram — для иконки-аватара в шапке (имя и фото). Необязательные.
  firstName        String?
  photoUrl         String?
  // Мягкое удаление: аккаунт в архиве, полное удаление через 30 дней; при повторном входе — восстановление.
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  consentAt        DateTime?
  consentVersion   String?
  memoryEnabled    Boolean  @default(true)
  historyEnabled   Boolean  @default(true)
  remindersEnabled Boolean  @default(true)
  // Частота бережных касаний, которую человек выбирает сам: rare | weekly | often (null = rare).
  reminderCadence  String?
  lastRemindedAt   DateTime?
  portrait         String?
  portraitAt       DateTime?
  // Медданные — особая категория ПД: отдельное согласие и отдельное отключение.
  healthEnabled    Boolean  @default(false)
  healthConsentAt  DateTime?
  healthConsentVer String?

  messages     Message[]
  memories     Memory[]
  healthDocs   HealthDoc[]
  healthMarkers HealthMarker[]
  healthReminders HealthReminder[]
  consents     Consent[]
  subscription Subscription?
  crisisEvents CrisisEvent[]
  calls        Call[]
  sessions     Session[]
  coachSessions CoachSession[]
  privateMessages PrivateMessage[]
  profileAnswers  ProfileAnswer[]
  offers          Offer[]
  requests        RequestPost[]
  networkConsents NetworkConsent[]
  bornYear        Int?
  gender          String?  // "female" | "male" | null — грамматический род обращения
  reportsMade     Report[]  @relation("reporter")
  blocksMade      Block[]   @relation("blocker")
}

// Структурированная сессия («разбор»): шаблон задаёт невидимый каркас вопросов,
// а разговор и итог — настоящие, из ответов человека.
model CoachSession {
  id        String    @id @default(cuid())
  userId    String
  template  String
  step      Int       @default(0)
  done      Boolean   @default(false)
  summary   String?
  savedAt   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns     SessionTurn[]

  @@index([userId, createdAt])
}

model SessionTurn {
  id        String       @id @default(cuid())
  sessionId String
  phase     Int
  role      String
  content   String
  createdAt DateTime     @default(now())
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  // Навык, в режиме которого написано сообщение (null = обычная Ася).
  skill     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, skill, createdAt])
}

// Инкогнито-переписка: хранится ТОЛЬКО зашифрованной (AES-GCM) ключом устройства.
// Сервер видит лишь iv и шифротекст (data) и прочитать содержимое не может.
model PrivateMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  iv        String
  data      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Профиль «о себе»: человек сам заполняет грани по вопросам. Дополняет авто-память, не заменяет.
model ProfileAnswer {
  id         String   @id @default(cuid())
  userId     String
  formId     String
  questionId String
  value      String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, formId, questionId])
  @@index([userId])
}

// ===================== СЕТЬ (доверенный посредник) =====================
// Категории: service | nanny | dating. Строгая стена: Ася брокерит ТОЛЬКО явные офферы,
// никогда не рекомендует из личных разговоров/инкогнито по своему усмотрению.

model NetworkConsent {
  id        String   @id @default(cuid())
  userId    String
  category  String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model Offer {
  id         String   @id @default(cuid())
  userId     String
  category   String
  title      String
  params     String?
  blurb      String?
  shareScope String?
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  intros     Intro[]

  @@index([category, status])
  @@index([userId])
}

model RequestPost {
  id        String    @id @default(cuid())
  userId    String
  category  String
  criteria  String?
  note      String?
  status    String    @default("open")
  deadline  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  intros    Intro[]

  @@index([category, status])
  @@index([userId])
}

model Intro {
  id          String      @id @default(cuid())
  requestId   String
  offerId     String
  candidateId String
  requesterId String
  status      String      @default("proposed")
  candidateOk Boolean     @default(false)
  requesterOk Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  request     RequestPost @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([requestId, offerId])
  @@index([candidateId, status])
  @@index([requesterId, status])
}

// --- Безопасность сети ---
model Room {
  id          String        @id @default(cuid())
  introId     String        @unique
  status      String        @default("active")
  asyaPresent Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     RoomMember[]
  messages    RoomMessage[]

  @@index([status])
}

model RoomMember {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  removeAsya Boolean  @default(false)
  lastReadAt DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  sender    String   // "user" | "asya"
  senderId  String?
  kind      String   @default("text") // text | system | warn
  content   String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  targetUserId String
  reason       String
  note         String?
  createdAt    DateTime @default(now())
  reporter     User     @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
}

model Block {
  id        String   @id @default(cuid())
  userId    String
  blockedId String
  createdAt DateTime @default(now())
  user      User     @relation("blocker", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
  @@index([blockedId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  fact      String
  topic     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, topic])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  version   String
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String    @unique
  status       String
  provider     String    @default("yookassa")
  externalId   String?
  nextChargeAt DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrisisEvent {
  id        String   @id @default(cuid())
  userId    String
  level     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Здоровье ---
// Документ: анализ, заключение врача, исследование. Сам файл не храним —
// только извлечённый текст и разобранные показатели.
model HealthDoc {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("lab") // lab | conclusion | imaging | other
  title     String
  docDate   DateTime? // дата документа (когда сдан анализ)
  lab       String? // лаборатория или клиника
  fileName  String?
  textRaw   String? // извлечённый текст — источник правды для показателей
  summary   String? // о чём документ, простыми словами (из модели, по фактам)
  status    String   @default("parsed") // parsed | failed
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markers   HealthMarker[]

  @@index([userId, docDate])
}

// Один показатель из документа. Всё, что здесь есть, напечатано в документе.
model HealthMarker {
  id        String   @id @default(cuid())
  userId    String
  docId     String
  code      String // нормализованный ключ, чтобы сравнивать между документами
  name      String // как назван в документе
  value     Float?
  valueText String? // если значение не число («отрицательно», «следы»)
  unit      String?
  refLow    Float?
  refHigh   Float?
  refText   String? // референс как напечатан
  flag      String? // norm | low | high — только если следует из документа
  takenAt   DateTime?
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc       HealthDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([userId, code, takenAt])
  @@index([docId])
}

// Напоминание о повторном обследовании. Создаётся только из текста документа
// или вручную — Ася не назначает обследования сама.
model HealthReminder {
  id        String   @id @default(cuid())
  userId    String
  title     String
  dueAt     DateTime
  source    String? // откуда: "документ" или "вручную"
  note      String?
  doneAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

// События воронки: чтобы видеть, сколько людей дошло до первого сообщения и вернулось.
// Персональных данных не храним — только имя события и обезличенный id посетителя.
model Event {
  id     String   @id @default(cuid())
  name   String
  anonId String?
  userId String?
  meta   String?
  ts     DateTime @default(now())

  @@index([name, ts])
  @@index([anonId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Серверный дневной счётчик сообщений. key = "u:<userId>:<yyyy-mm-dd>" для вошедших,
// "ip:<ip>:<yyyy-mm-dd>" для анонимов. Защита от злоупотреблений и мягкий лимит.
model DailyUsage {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
}


// Кеш общих объяснений показателей здоровья (заземление на литературу). Не пользовательские данные —
// общее знание по коду показателя и направлению (low/high/general). Источники не храним.
model HealthTermInfo {
  id        String   @id @default(cuid())
  key       String   @unique
  code      String
  direction String
  text      String
  createdAt DateTime @default(now())

  @@index([code])
}

// Кеш озвученных ответов Аси (ElevenLabs TTS). Хеш = voiceKey:текст, чтобы повтор
// не тратил деньги. Аудио — mp3 в bytea. Не пользовательские данные (реплики Аси).
model VoiceClip {
  id        String   @id @default(cuid())
  hash      String   @unique
  audio     Bytes
  chars     Int
  createdAt DateTime @default(now())
}


// Звонки: асинхронный ассистент-автоответчик. Voximplant присылает расшифровку сообщения
// звонящего в вебхук, Ася делает резюме и оценку важности, запись показывается во «Звонках».
model Call {
  id           String   @id @default(cuid())
  userId       String
  fromNumber   String?
  fromName     String?
  startedAt    DateTime @default(now())
  durationSec  Int      @default(0)
  transcript   String?
  summary      String?
  importance   String   @default("unknown") // spam | low | normal | important | unknown
  category     String?
  recordingUrl String?
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}


// Кто уже прошёл капчу в конкретном чате (проверка по первому сообщению, а не по входу —
// надёжнее для чатов-обсуждений каналов, где вход не всегда создаёт событие).
model VerifiedMember {
  chatId    String
  userId    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([chatId, userId])
}


// База знаний агента поддержки: закрытая, редактируется доверенными людьми (и Асей программно).
// space — раздел/сообщество (напр. "studio"); поиск пока простой (вся релевантная база в контекст).
model KnowledgeArticle {
  id        String   @id @default(cuid())
  space     String   @default("default")
  title     String
  body      String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([space])
}


// Настройки Аси по каждому чату (видны и редактируются в админке).
// role: off | support | moderation | both. support — только отвечает по базе, без модерации.
model ChatConfig {
  chatId    String   @id
  title     String?
  role      String   @default("support")
  space     String   @default("default")
  rules     String?
  repoUrl   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
