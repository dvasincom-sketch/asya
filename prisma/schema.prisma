// Ася — схема БД. Полная модель под весь продукт; на шаге 2 (чат) ещё не используется,
// но лежит готовой для шагов 3+ (вход, память, история, подписка).
generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки, debian-openssl-3.0.x — для Docker-образа (node:20-bookworm)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  tgId             BigInt?  @unique
  phone            String?  @unique
  createdAt        DateTime @default(now())
  consentAt        DateTime?
  consentVersion   String?
  memoryEnabled    Boolean  @default(true)
  historyEnabled   Boolean  @default(true)
  remindersEnabled Boolean  @default(true)
  portrait         String?
  portraitAt       DateTime?
  // Медданные — особая категория ПД: отдельное согласие и отдельное отключение.
  healthEnabled    Boolean  @default(false)
  healthConsentAt  DateTime?
  healthConsentVer String?

  messages     Message[]
  memories     Memory[]
  healthDocs   HealthDoc[]
  healthMarkers HealthMarker[]
  healthReminders HealthReminder[]
  consents     Consent[]
  subscription Subscription?
  crisisEvents CrisisEvent[]
  sessions     Session[]
  coachSessions CoachSession[]
  privateMessages PrivateMessage[]
}

// Структурированная сессия («разбор»): шаблон задаёт невидимый каркас вопросов,
// а разговор и итог — настоящие, из ответов человека.
model CoachSession {
  id        String    @id @default(cuid())
  userId    String
  template  String
  step      Int       @default(0)
  done      Boolean   @default(false)
  summary   String?
  savedAt   DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns     SessionTurn[]

  @@index([userId, createdAt])
}

model SessionTurn {
  id        String       @id @default(cuid())
  sessionId String
  phase     Int
  role      String
  content   String
  createdAt DateTime     @default(now())
  session   CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  // Навык, в режиме которого написано сообщение (null = обычная Ася).
  skill     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, skill, createdAt])
}

// Инкогнито-переписка: хранится ТОЛЬКО зашифрованной (AES-GCM) ключом устройства.
// Сервер видит лишь iv и шифротекст (data) и прочитать содержимое не может.
model PrivateMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  iv        String
  data      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  fact      String
  topic     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, topic])
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  version   String
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String    @unique
  status       String
  provider     String    @default("yookassa")
  externalId   String?
  nextChargeAt DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrisisEvent {
  id        String   @id @default(cuid())
  userId    String
  level     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Здоровье ---
// Документ: анализ, заключение врача, исследование. Сам файл не храним —
// только извлечённый текст и разобранные показатели.
model HealthDoc {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("lab") // lab | conclusion | imaging | other
  title     String
  docDate   DateTime? // дата документа (когда сдан анализ)
  lab       String? // лаборатория или клиника
  fileName  String?
  textRaw   String? // извлечённый текст — источник правды для показателей
  summary   String? // о чём документ, простыми словами (из модели, по фактам)
  status    String   @default("parsed") // parsed | failed
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markers   HealthMarker[]

  @@index([userId, docDate])
}

// Один показатель из документа. Всё, что здесь есть, напечатано в документе.
model HealthMarker {
  id        String   @id @default(cuid())
  userId    String
  docId     String
  code      String // нормализованный ключ, чтобы сравнивать между документами
  name      String // как назван в документе
  value     Float?
  valueText String? // если значение не число («отрицательно», «следы»)
  unit      String?
  refLow    Float?
  refHigh   Float?
  refText   String? // референс как напечатан
  flag      String? // norm | low | high — только если следует из документа
  takenAt   DateTime?
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doc       HealthDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([userId, code, takenAt])
  @@index([docId])
}

// Напоминание о повторном обследовании. Создаётся только из текста документа
// или вручную — Ася не назначает обследования сама.
model HealthReminder {
  id        String   @id @default(cuid())
  userId    String
  title     String
  dueAt     DateTime
  source    String? // откуда: "документ" или "вручную"
  note      String?
  doneAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

// События воронки: чтобы видеть, сколько людей дошло до первого сообщения и вернулось.
// Персональных данных не храним — только имя события и обезличенный id посетителя.
model Event {
  id     String   @id @default(cuid())
  name   String
  anonId String?
  userId String?
  meta   String?
  ts     DateTime @default(now())

  @@index([name, ts])
  @@index([anonId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Серверный дневной счётчик сообщений. key = "u:<userId>:<yyyy-mm-dd>" для вошедших,
// "ip:<ip>:<yyyy-mm-dd>" для анонимов. Защита от злоупотреблений и мягкий лимит.
model DailyUsage {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
}
