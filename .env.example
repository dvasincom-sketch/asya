# --- Timeweb AI Gateway ---
TIMEWEB_API_KEY=
TIMEWEB_BASE_URL=https://api.timeweb.ai/v1
TIMEWEB_MODEL=t-tech/T-pro-it-1.0

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/asya

# --- Вход через Telegram ---
# Токен бота от @BotFather. У бота задать домен: /setdomain -> ася.онлайн (для локали localhost)
TELEGRAM_BOT_TOKEN=
# Юзернейм бота без @ (виден во фронте — используется виджетом входа)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Вход по телефону (SMS) ---
# api_id от sms.ru. Если пусто — код входа печатается в лог сервера (удобно в разработке)
SMS_API_ID=
