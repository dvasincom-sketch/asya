# --- Timeweb AI Gateway ---
TIMEWEB_API_KEY=
TIMEWEB_BASE_URL=https://api.timeweb.ai/v1
TIMEWEB_MODEL=t-tech/T-pro-it-1.0

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/asya

# --- Вход через Telegram ---
# Токен бота от @BotFather. У бота задать домен: /setdomain -> ася.онлайн (для локали localhost)
TELEGRAM_BOT_TOKEN=
# Юзернейм бота без @ (виден во фронте — используется виджетом входа)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Секрет вебхука бота (любая случайная строка). Нужен для установки и проверки вебхука.
TELEGRAM_WEBHOOK_SECRET=
# Публичный адрес приложения для вебхука (если не задан — берётся из запроса). Пример: https://ася.онлайн
PUBLIC_BASE_URL=

# --- Вход по телефону (SMS) ---
# api_id от sms.ru. Если пусто — код входа печатается в лог сервера (удобно в разработке)
SMS_API_ID=

# --- Юридические реквизиты (видны на страницах политики и оферты) ---
NEXT_PUBLIC_SITE_HOST=ася.online
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_OGRNIP=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PLUS_PRICE=300 ₽

# --- Сводка по воронке: /admin?key=... ---
ADMIN_KEY=

# --- Запись в салон (insalon) ---
SALON_API_URL=https://insalon.onrender.com
SALON_NAME=HeadSPA Beauty
# SALON_ENABLED=0 — выключить запись в чате
SALON_ENABLED=1
# Внутренний ключ для доступа к записям клиента (такой же задать в insalon как INTERNAL_API_KEY)
SALON_INTERNAL_KEY=
